# tools/coverage/BUILD.bazel

package(default_visibility = ["//visibility:public"])

# This defines the configuration for our Clang toolchain,
# specifically overriding the gcov tool path.
cc_toolchain_config(
    name = "cc-clang-coverage-config",
    compiler = "clang",
    cpu = "k8", # A common default, adjust if needed for your architecture
    cxx_flag = ["-std=c++17"],
    linker_flag = ["-lm"],
    toolchain_identifier = "clang-coverage-toolchain",
    tool_path = [
        # This is the key change: we point the 'gcov' tool to our wrapper script.
        tool_path(name = "gcov", path = "llvm-gcov-wrapper.sh"),
        # Define other tools to make the toolchain complete.
        # Adjust these paths if clang/ld are not in your system's default PATH.
        tool_path(name = "ar", path = "/usr/bin/ar"),
        tool_path(name = "cpp", path = "/usr/bin/clang-c++"),
        tool_path(name = "gcc", path = "/usr/bin/clang"),
        tool_path(name = "ld", path = "/usr/bin/ld"),
        tool_path(name = "nm", path = "/usr/bin/nm"),
        tool_path(name = "objcopy", path = "/usr/bin/objcopy"),
        tool_path(name = "objdump", path = "/usr/bin/objdump"),
        tool_path(name = "strip", path = "/usr/bin/strip"),
    ],
)

# This creates the actual toolchain target that Bazel can use.
cc_toolchain(
    name = "cc-clang-coverage-toolchain",
    toolchain_config = ":cc-clang-coverage-config",
    toolchain_identifier = "clang-coverage-toolchain",
    # Point to the wrapper script and other files needed by the toolchain.
    all_files = ":wrapper",
    compiler_files = ":wrapper",
    dwp_files = ":empty",
    linker_files = ":wrapper",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 1,
)

# A filegroup to bundle the wrapper script for the toolchain.
filegroup(
    name = "wrapper",
    srcs = ["llvm-gcov-wrapper.sh"],
)

# An empty filegroup for toolchain attributes that we don't need.
filegroup(name = "empty")