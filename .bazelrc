# See e.g. https://blog.aspect.dev/bazelrc-flags

# https://github.com/bazelbuild/rules_foreign_cc/issues/1129
build --noincompatible_sandbox_hermetic_tmp

# Workspace settings
build --enable_workspace
fetch --noenable_bzlmod
build --noenable_bzlmod

# --- Good Practice Flags (Kept) ---
build --incompatible_default_to_explicit_init_py
build --cxxopt=-std=c++17
build --sandbox_default_allow_network=false
build --incompatible_disallow_empty_glob
common --action_env=PYTHONNOUSERSITE=1
common --incompatible_strict_action_env
build --heap_dump_on_oom
build --noexperimental_check_output_files
test --build_tests_only
test --test_output=errors

# --- Clang Configuration (Kept) ---
# This config is used by 'coverage'
#build:clang --repo_env=CC=clang
#build:clang --repo_env=CXX=clang++
#build:clang --linkopt="-fuse-ld=lld"
#test:clang --repo_env=CC=clang
#test:clang --repo_env=CXX=clang++
#test:clang --linkopt="-fuse-ld=lld"

build:clang --compiler=clang
build:clang --cxxopt=-std=c++17
build:clang --cxxopt=-fprofile-instr-generate
build:clang --cxxopt=-fcoverage-mapping
build:clang --linkopt=-fprofile-instr-generate
build:clang --linkopt=-fcoverage-mapping


# --- COVERAGE CONFIGURATION (CORRECTED) ---

# This line activates the clang configuration above for all coverage builds.
#coverage --config=clang

# This is the single, most important line. It tells Bazel to use
# the toolchain we have been building.
#coverage --extra_toolchains=//tools/coverage:etharialle_coverage

### REMOVED the following conflicting/redundant lines: ###
# coverage --experimental_generate_llvm_lcov  <-- CONFLICTS with extra_toolchains
# coverage --copt=--coverage                  <-- REDUNDANT, handled by our toolchain
# coverage --linkopt=--coverage               <-- REDUNDANT, handled by our toolchain
# coverage --linkopt="-fuse-ld=lld"           <-- REDUNDANT, inherited from --config=clang


# --- User Settings ---
# This must be the last line.
try-import %workspace%/user.bazelrc